# Server only: never place an API key in index.html or any public file.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-4o-mini
PORT=8788
# Optional public support address; the owner will create this separately.
SUPPORT_EMAIL=
# Property contact opens Gmail drafts. No mail service or Gmail permissions needed.
# Leave 0 for direct connections. For a reverse proxy, configure its verified hop
# count only when requests cannot bypass that proxy. Count from the socket backward.
TRUST_PROXY_HOPS=0
# Optional writable persistent directory for BOTH sponsor campaigns and counters.
# DATA_DIR=/var/data
