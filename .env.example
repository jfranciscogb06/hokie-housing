# Server only: never place an API key in index.html or any public file.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-4o-mini
PORT=8788
# Direct messages to properties (Request info). Get a key at resend.com and verify
# the sending domain. Without these, Request info opens a Gmail draft instead.
RESEND_API_KEY=
MAIL_FROM=Hokie Housing <messages@your-domain.com>
